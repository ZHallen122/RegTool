# An empty home directory has no package manager to report on.
exec regtool status
! stderr .
stdout '^no supported package manager was found on this machine$'

# status reads the configuration files directly, so it works without npm or gem
# being installed at all.
cp npmrc $HOME/.npmrc
cp gemrc $HOME/.gemrc

exec regtool status
! stderr .
stdout '^APP\s+REGION\s+URL$'
stdout '^npm\s+us\s+https://registry\.npmjs\.org/$'
stdout '^gem\s+local\s+https://gems\.example\.com$'

# --json writes the same thing to stdout and nothing to stderr.
exec regtool status --json
! stderr .
stdout '"app": "npm"'
stdout '"region": "us"'
stdout '"app": "gem"'
stdout '"region": "local"'

-- npmrc --
registry=https://registry.npmjs.org/
-- gemrc --
---
:sources:
  - https://gems.example.com
