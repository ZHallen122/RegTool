# A dry run prints the diff it would apply and leaves the file untouched.
cp npmrc $HOME/.npmrc

exec regtool use cn npm --dry-run
! stderr .
stdout '^dry run: no configuration was changed$'
stdout '^npm\s+https://registry\.npmjs\.org\s+https://registry\.npmmirror\.com\s+would change$'
stdout '^npm:$'
stdout '^-registry=https://registry\.npmjs\.org$'
stdout '^\+registry=https://registry\.npmmirror\.com$'

# Nothing was written and nothing was snapshotted.
cmp $HOME/.npmrc npmrc
exec regtool history
stdout '^regtool has not changed anything yet$'

# --json carries the diff too.
exec regtool use cn npm --dry-run --json
! stderr .
stdout '"dryRun": true'
stdout '"app": "npm"'
stdout 'registry=https://registry.npmmirror.com'
cmp $HOME/.npmrc npmrc

-- npmrc --
registry=https://registry.npmjs.org
