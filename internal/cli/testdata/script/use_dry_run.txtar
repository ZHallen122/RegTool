# a dry run reports the change it would make...
exec regtool use cn npm --dry-run
! stderr .
stdout '^dry run: no configuration was changed$'
stdout '^npm\s+https://registry\.npmjs\.org/\s+https://registry\.npmmirror\.com\s+would change$'

# ...and leaves the backend exactly where it was.
exec regtool status
stdout '^npm\s+us\s+https://registry\.npmjs\.org/$'

# without --dry-run the change is applied.
exec regtool use cn npm
! stderr .
stdout '^npm\s+https://registry\.npmjs\.org/\s+https://registry\.npmmirror\.com\s+changed$'

exec regtool status
stdout '^npm\s+cn\s+https://registry\.npmmirror\.com$'
stdout '^pip\s+local\s+https://pypi\.example\.com/simple$'

# with no app names every installed app is switched.
exec regtool use us --json
! stderr .
stdout '"app": "pip"'
stdout '"to": "https://pypi.org/simple"'

exec regtool status
stdout '^npm\s+us\s+https://registry\.npmjs\.org$'
stdout '^pip\s+us\s+https://pypi\.org/simple$'
